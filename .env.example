# Copy to .env and adjust. Every key here maps to a field in app/config.py.

# Model
MODEL_ID=microsoft/Florence-2-base
MODEL_VERSION=florence-2-base-v1
DEVICE=cuda
MAX_NEW_TOKENS=256

# Dynamic batching (MAX_BATCH_SIZE=1 turns batching off)
MAX_BATCH_SIZE=8
MAX_BATCH_WAIT_MS=10
MAX_QUEUE_SIZE=64
INFERENCE_TIMEOUT_S=10

# Uploads
MAX_UPLOAD_BYTES=5242880

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://visionserve:visionserve@localhost:5432/visionserve
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_S=86400
RATE_LIMIT_ALGORITHM=token_bucket

# Object storage (MinIO locally). For AWS S3: unset S3_ENDPOINT_URL and use real keys.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=visionserve-images
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PRESIGNED_URL_TTL_S=900

# If set, POST /v1/users requires header X-Admin-Token with this value.
ADMIN_TOKEN=change-me

# Logging (LOG_JSON=false gives readable console logs)
LOG_LEVEL=INFO
LOG_JSON=true
